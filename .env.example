# apps/api
# Runtime connection: limited role, RLS applies (tenant isolation, SEC-1)
DATABASE_URL=postgres://veriq:veriq@localhost:5433/veriq
# Owner connection: migrations + auth module only
DATABASE_OWNER_URL=postgres://veriq:veriq@localhost:5433/veriq
PORT=3000
SEED_ON_BOOT=true
SEED_ADMIN_PASSWORD=veriq-dev-admin

# OIDC (CORE-ID-2). Leave unset to disable SSO login.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=veriq
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=http://localhost:3002/api/auth/oidc/callback
